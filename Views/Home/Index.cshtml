@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

@model app1.Models.CircleViewModel

<form asp-action="Index" method="post">
    <div style="display: flex; align-items: center;">
        <label for="rr" style="margin-right: 10px;">Bán kính:</label>
        <input asp-for="rr" />
        <input type="submit" value="Tính" style="margin-left: 10px;" />
    </div>

    <span asp-validation-for="rr" class="text-danger" style="display: block; margin-top: 5px;"></span> <!-- Chữ cảnh báo xuống dòng -->
</form>

@if (Model.rr > 0)
{
    <div>
        Diện tích: @Model.DienTich
        <br />
        Chu vi: @Model.ChuVi
        <br />
        Đường kính: @Model.DuongKinh
    </div>

}